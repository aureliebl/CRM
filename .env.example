# Runtime is PostgreSQL-only
DATABASE_URL=postgres://user:password@localhost:5432/costotest

# Optional: set true on managed PG providers requiring SSL
PGSSL=false

# Signed HTTP-only session cookie secret (required outside local dev)
APP_SESSION_SECRET=change-me-with-a-long-random-secret

# Temporary transition flag only (default false):
# when true, API auth can still read userId query/header if no valid session cookie.
ALLOW_LEGACY_ACTOR_FALLBACK=false

# Temporary transition flag for login (default false in prod):
# when true, legacy demo password (demo123) can still authenticate existing accounts.
DEMO_AUTH=true

# Password reset URL used in email links
PASSWORD_RESET_URL_BASE=http://localhost:3000/resetlogin

# Optional SMTP config (if empty, reset emails are logged server-side in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@costockage.local
APP_NAME=Costockage

# Brevo SMTP example (do not commit real secrets):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<BREVO_SMTP_LOGIN>
# SMTP_PASS=<BREVO_SMTP_KEY>
# SMTP_FROM=no-reply@your-domain.tld

# Auth rate limiting (defaults are applied if unset)
AUTH_RATE_LIMIT_LOGIN_MAX=8
AUTH_RATE_LIMIT_LOGIN_WINDOW_MS=900000
AUTH_RATE_LIMIT_LOGIN_BLOCK_MS=900000

AUTH_RATE_LIMIT_INTERNAL_LOGIN_MAX=20
AUTH_RATE_LIMIT_INTERNAL_LOGIN_WINDOW_MS=900000
AUTH_RATE_LIMIT_INTERNAL_LOGIN_BLOCK_MS=900000

AUTH_RATE_LIMIT_RESET_SUBMIT_MAX=8
AUTH_RATE_LIMIT_RESET_SUBMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_RESET_SUBMIT_BLOCK_MS=900000

AUTH_RATE_LIMIT_RESET_EMAIL_MAX=30
AUTH_RATE_LIMIT_RESET_EMAIL_WINDOW_MS=3600000
AUTH_RATE_LIMIT_RESET_EMAIL_BLOCK_MS=3600000

AUTH_RATE_LIMIT_CHANGE_PASSWORD_MAX=8
AUTH_RATE_LIMIT_CHANGE_PASSWORD_WINDOW_MS=900000
AUTH_RATE_LIMIT_CHANGE_PASSWORD_BLOCK_MS=900000
